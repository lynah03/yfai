<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>AI Scent Concierge — {{ brand.name }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <style>
        :root {
            --bg: #050505;
            --panel: #111111;
            --ivory: #f7f1e8;
            --muted: #b8afa3;
            --border: rgba(247, 241, 232, 0.16);
            --gold: #c8a96a;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            background:
                radial-gradient(circle at top, rgba(200, 169, 106, 0.14), transparent 34rem),
                var(--bg);
            color: var(--ivory);
            font-family: Georgia, "Times New Roman", serif;
        }

        button, input { font-family: inherit; }

        .page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 16px;
        }

        .concierge {
            width: 100%;
            max-width: 980px;
            border: 1px solid var(--border);
            border-radius: 28px;
            background: rgba(17, 17, 17, 0.94);
            box-shadow: 0 40px 120px rgba(0, 0, 0, 0.5);
            overflow: hidden;
        }

        .header {
            padding: 28px 32px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            gap: 24px;
            align-items: center;
        }

        .eyebrow {
            margin: 0 0 8px;
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 0.26em;
            font-size: 11px;
        }

        .brand-name {
            margin: 0;
            font-size: 26px;
            font-weight: 500;
        }

        .tag {
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 10px 14px;
            color: var(--muted);
            font-size: 13px;
            white-space: nowrap;
        }

        .content { padding: 44px 32px; }

        .progress {
            height: 1px;
            background: var(--border);
            margin-bottom: 34px;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            background: var(--gold);
            transition: width 240ms ease;
        }

        .step {
            display: none;
            animation: fadeIn 220ms ease-out;
        }

        .step.active { display: block; }

        .center {
            text-align: center;
            max-width: 720px;
            margin: 0 auto;
        }

        h2 {
            margin: 0;
            font-size: clamp(34px, 5vw, 58px);
            line-height: 1.02;
            font-weight: 400;
            letter-spacing: -0.04em;
        }

        .subtitle {
            margin: 20px auto 0;
            max-width: 620px;
            color: var(--muted);
            font-size: 18px;
            line-height: 1.6;
        }

        .question {
            max-width: 760px;
            margin: 0 auto;
        }

        .question h2 {
            font-size: clamp(30px, 4vw, 46px);
        }

        .options {
            margin-top: 32px;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }

        .option {
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.03);
            color: var(--ivory);
            padding: 18px;
            border-radius: 18px;
            cursor: pointer;
            text-align: left;
            font-size: 16px;
            transition: 160ms ease;
        }

        .option:hover,
        .option.selected {
            border-color: var(--gold);
            background: rgba(200, 169, 106, 0.12);
            transform: translateY(-1px);
        }

        .actions {
            margin-top: 34px;
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn {
            border: 1px solid var(--gold);
            background: var(--ivory);
            color: #050505;
            border-radius: 999px;
            padding: 14px 24px;
            font-size: 15px;
            cursor: pointer;
            transition: 160ms ease;
        }

        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 16px 40px rgba(200, 169, 106, 0.18);
        }

        .btn.secondary {
            background: transparent;
            color: var(--ivory);
            border-color: var(--border);
        }

        .pulse {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            border: 1px solid var(--gold);
            margin: 0 auto 26px;
            position: relative;
        }

        .pulse::after {
            content: "";
            position: absolute;
            inset: -10px;
            border-radius: 50%;
            border: 1px solid rgba(200, 169, 106, 0.32);
            animation: pulse 1.3s infinite;
        }

        .loading-copy {
            margin-top: 28px;
            color: var(--muted);
            font-size: 17px;
        }

        .results {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
            margin-top: 34px;
        }

        .result-card {
            border: 1px solid var(--border);
            border-radius: 22px;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.035);
        }

        .result-image {
            height: 230px;
            background: rgba(255, 255, 255, 0.04);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 22px;
        }

        .result-image img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .no-image {
            color: var(--muted);
            font-size: 13px;
        }

        .result-body { padding: 20px; }

        .result-brand {
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 0.18em;
            font-size: 10px;
            margin-bottom: 8px;
        }

        .result-name {
            font-size: 24px;
            margin: 0;
            font-weight: 400;
        }

        .result-desc {
            color: var(--muted);
            line-height: 1.5;
            font-size: 14px;
            min-height: 64px;
        }

        .meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: 16px 0;
        }

        .pill {
            border: 1px solid var(--border);
            color: var(--muted);
            border-radius: 999px;
            padding: 6px 9px;
            font-size: 12px;
        }

        .reason-list {
            padding-left: 18px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.4;
        }

        .result-link {
            display: inline-flex;
            margin-top: 14px;
            color: #050505;
            background: var(--ivory);
            border-radius: 999px;
            padding: 10px 14px;
            text-decoration: none;
            font-size: 13px;
        }

        .error {
            color: #ffb4a8;
            margin-top: 20px;
            text-align: center;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes pulse {
            from { transform: scale(0.9); opacity: 0.9; }
            to { transform: scale(1.25); opacity: 0; }
        }

        @media (max-width: 800px) {
            .header {
                align-items: flex-start;
                flex-direction: column;
            }

            .content { padding: 34px 20px; }

            .options,
            .results {
                grid-template-columns: 1fr;
            }

            .tag { white-space: normal; }
        }
    </style>
</head>

<body>
<div class="page">
    <main class="concierge"
          data-brand-name="{{ brand.name }}"
          data-recommend-url="{{ path('ai_scent_concierge_recommend', { customerName: brand.name }) }}">

        <header class="header">
            <div>
                <p class="eyebrow">YFAI AI Scent Concierge</p>
                <h1 class="brand-name">{{ brand.name }}</h1>
            </div>

            <div class="tag">AI-powered fragrance discovery</div>
        </header>

        <section class="content">
            <div class="progress">
                <div class="progress-bar" id="progressBar"></div>
            </div>

            <div class="step active" data-step="0">
                <div class="center">
                    <h2>Your personal AI fragrance concierge.</h2>
                    <p class="subtitle">
                        Answer a few questions and discover the {{ brand.name }} scent that matches your mood,
                        skin and personal style.
                    </p>

                    <div class="actions">
                        <button class="btn" type="button" data-next>Start the experience</button>
                    </div>
                </div>
            </div>

            <div class="step" data-step="1" data-key="mood">
                <div class="question">
                    <h2>What kind of feeling are you looking for?</h2>
                    <p class="subtitle">Choose the mood you want your fragrance to leave behind.</p>

                    <div class="options">
                        <button class="option" type="button" data-value="mysterious">Mysterious</button>
                        <button class="option" type="button" data-value="sensual">Sensual</button>
                        <button class="option" type="button" data-value="powerful">Powerful</button>
                        <button class="option" type="button" data-value="clean">Clean</button>
                    </div>
                </div>
            </div>

            <div class="step" data-step="2" data-key="notes" data-multiple="true">
                <div class="question">
                    <h2>Which notes do you usually love?</h2>
                    <p class="subtitle">Select up to three notes.</p>

                    <div class="options">
                        <button class="option" type="button" data-value="Incense">Incense</button>
                        <button class="option" type="button" data-value="Leather">Leather</button>
                        <button class="option" type="button" data-value="Oud">Oud</button>
                        <button class="option" type="button" data-value="Rose">Rose</button>
                        <button class="option" type="button" data-value="Vanilla">Vanilla</button>
                        <button class="option" type="button" data-value="Musk">Musk</button>
                        <button class="option" type="button" data-value="Spices">Spices</button>
                        <button class="option" type="button" data-value="Citrus">Citrus</button>
                    </div>

                    <div class="actions">
                        <button class="btn" type="button" data-next>Continue</button>
                    </div>
                </div>
            </div>

            <div class="step" data-step="3" data-key="occasion">
                <div class="question">
                    <h2>When would you wear it?</h2>
                    <p class="subtitle">Tell us the moment you have in mind.</p>

                    <div class="options">
                        <button class="option" type="button" data-value="EVERYDAY">Everyday</button>
                        <button class="option" type="button" data-value="DATE_NIGHT">Date night</button>
                        <button class="option" type="button" data-value="EVENING">Evening</button>
                        <button class="option" type="button" data-value="WORK">Work</button>
                    </div>
                </div>
            </div>

            <div class="step" data-step="4" data-key="intensity">
                <div class="question">
                    <h2>How intense should your fragrance be?</h2>
                    <p class="subtitle">From subtle elegance to unforgettable presence.</p>

                    <div class="options">
                        <button class="option" type="button" data-value="soft">Soft and close to the skin</button>
                        <button class="option" type="button" data-value="balanced">Balanced and elegant</button>
                        <button class="option" type="button" data-value="strong">Strong and unforgettable</button>
                    </div>
                </div>
            </div>

            <div class="step" data-step="5" data-key="budget">
                <div class="question">
                    <h2>What is your ideal budget?</h2>
                    <p class="subtitle">We will keep your selection aligned with your range.</p>

                    <div class="options">
                        <button class="option" type="button" data-value="under_100">Under €100</button>
                        <button class="option" type="button" data-value="100_200">€100–€200</button>
                        <button class="option" type="button" data-value="200_300">€200–€300</button>
                        <button class="option" type="button" data-value="300_plus">€300+</button>
                    </div>
                </div>
            </div>

            <div class="step" data-step="6">
                <div class="center">
                    <div class="pulse"></div>
                    <h2>Your AI Scent Concierge is analysing your profile...</h2>
                    <p class="loading-copy" id="loadingCopy">Reading your scent profile...</p>
                </div>
            </div>

            <div class="step" data-step="7">
                <div class="center">
                    <p class="eyebrow">Your matches</p>
                    <h2>Your {{ brand.name }} recommendations.</h2>
                    <p class="subtitle">
                        Selected from {{ brand.name }}’s own fragrance universe.
                    </p>
                </div>

                <div id="results" class="results"></div>

                <div class="actions">
                    <button class="btn secondary" type="button" data-restart>Restart</button>
                </div>
            </div>

            <div id="error" class="error"></div>
        </section>
    </main>
</div>

<script>
    (() => {
        const root = document.querySelector('.concierge');
        const brandName = root.dataset.brandName;
        const recommendUrl = root.dataset.recommendUrl;
        const steps = Array.from(document.querySelectorAll('.step'));
        const progressBar = document.getElementById('progressBar');
        const resultsContainer = document.getElementById('results');
        const errorContainer = document.getElementById('error');

        let currentStep = 0;

        const answers = {
            mood: null,
            notes: [],
            occasion: null,
            intensity: null,
            budget: null
        };

        const moodToNotes = {
            mysterious: ['Incense', 'Oud', 'Leather'],
            sensual: ['Vanilla', 'Musk', 'Rose'],
            powerful: ['Leather', 'Spices', 'Oud'],
            clean: ['Musk', 'Citrus', 'Iris']
        };

        const intensityToConcentration = {
            soft: 'EAU_DE_TOILETTE',
            balanced: 'EAU_DE_PARFUM',
            strong: 'PARFUM'
        };

        const budgetMap = {
            under_100: { budget_min: 0, budget_max: 100 },
            '100_200': { budget_min: 100, budget_max: 200 },
            '200_300': { budget_min: 200, budget_max: 300 },
            '300_plus': { budget_min: 300, budget_max: null }
        };

        function showStep(index) {
            currentStep = index;

            steps.forEach((step) => {
                step.classList.toggle('active', Number(step.dataset.step) === index);
            });

            const percentage = Math.min(100, Math.round((index / (steps.length - 1)) * 100));
            progressBar.style.width = percentage + '%';
        }

        function goNext() {
            showStep(currentStep + 1);
        }

        function buildPayload() {
            const moodNotes = answers.mood && moodToNotes[answers.mood] ? moodToNotes[answers.mood] : [];
            const selectedNotes = answers.notes || [];
            const preferredNotes = Array.from(new Set([...moodNotes, ...selectedNotes]));
            const budget = answers.budget && budgetMap[answers.budget] ? budgetMap[answers.budget] : {};

            return {
                preferred_notes: preferredNotes,
                preferred_brands: [brandName],
                preferred_occasions: answers.occasion ? [answers.occasion] : [],
                concentration: answers.intensity ? intensityToConcentration[answers.intensity] : null,
                budget_min: budget.budget_min ?? null,
                budget_max: budget.budget_max ?? null,
                limit: 3,
                maxReasons: 5
            };
        }

        async function runRecommendation() {
            errorContainer.textContent = '';
            showStep(6);

            const loadingLines = [
                'Reading your scent profile...',
                'Matching emotional notes...',
                `Selecting your ${brandName} fragrances...`
            ];

            let lineIndex = 0;
            const loadingCopy = document.getElementById('loadingCopy');
            const loadingInterval = setInterval(() => {
                lineIndex = (lineIndex + 1) % loadingLines.length;
                loadingCopy.textContent = loadingLines[lineIndex];
            }, 700);

            try {
                await new Promise(resolve => setTimeout(resolve, 1400));

                const response = await fetch(recommendUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(buildPayload())
                });

                const data = await response.json();

                clearInterval(loadingInterval);

                if (!response.ok || !data.ok) {
                    throw new Error(data.message || 'Unable to generate recommendations.');
                }

                renderResults(data.results || []);
                showStep(7);
            } catch (error) {
                clearInterval(loadingInterval);
                errorContainer.textContent = error.message || 'Something went wrong.';
                showStep(5);
            }
        }

        function renderResults(results) {
            resultsContainer.innerHTML = '';

            if (!results.length) {
                resultsContainer.innerHTML = `
                    <div class="result-card" style="grid-column: 1 / -1;">
                        <div class="result-body">
                            <h3 class="result-name">No match found yet.</h3>
                            <p class="result-desc">
                                Try adjusting your answers to reveal more fragrance matches.
                            </p>
                        </div>
                    </div>
                `;
                return;
            }

            results.forEach((item) => {
                const price = item.listPriceCents !== null && item.listPriceCents !== undefined
                    ? `${(item.listPriceCents / 100).toFixed(2)} ${item.listPriceCurrency || 'EUR'}`
                    : null;

                const description = item.shortDescription || item.description || 'A fragrance selected by your AI Scent Concierge.';

                const reasons = (item.reasons || [])
                    .slice(0, 3)
                    .map(reason => `<li>${escapeHtml(reason)}</li>`)
                    .join('');

                const image = item.imageUrl
                    ? `<img src="${escapeHtml(item.imageUrl)}" alt="${escapeHtml(item.name)}">`
                    : `<span class="no-image">No image yet</span>`;

                const cta = item.productUrl
                    ? `<a class="result-link" href="${escapeHtml(item.productUrl)}" target="_blank" rel="noopener noreferrer">Discover ${escapeHtml(item.name)}</a>`
                    : '';

                resultsContainer.innerHTML += `
                    <article class="result-card">
                        <div class="result-image">
                            ${image}
                        </div>

                        <div class="result-body">
                            <div class="result-brand">${escapeHtml(item.brand || brandName)}</div>
                            <h3 class="result-name">${escapeHtml(item.name)}</h3>
                            <p class="result-desc">${escapeHtml(description)}</p>

                            <div class="meta">
                                ${item.concentration ? `<span class="pill">${escapeHtml(item.concentration)}</span>` : ''}
                                ${price ? `<span class="pill">${escapeHtml(price)}</span>` : ''}
                            </div>

                            ${reasons ? `<ol class="reason-list">${reasons}</ol>` : ''}
                            ${cta}
                        </div>
                    </article>
                `;
            });
        }

        function escapeHtml(value) {
            return String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        document.querySelectorAll('[data-next]').forEach(button => {
            button.addEventListener('click', goNext);
        });

        document.querySelectorAll('[data-restart]').forEach(button => {
            button.addEventListener('click', () => {
                answers.mood = null;
                answers.notes = [];
                answers.occasion = null;
                answers.intensity = null;
                answers.budget = null;

                document.querySelectorAll('.option.selected').forEach(option => {
                    option.classList.remove('selected');
                });

                resultsContainer.innerHTML = '';
                errorContainer.textContent = '';
                showStep(0);
            });
        });

        document.querySelectorAll('.step[data-key]').forEach(step => {
            const key = step.dataset.key;
            const multiple = step.dataset.multiple === 'true';
            const options = Array.from(step.querySelectorAll('.option'));

            options.forEach(option => {
                option.addEventListener('click', () => {
                    const value = option.dataset.value;

                    if (multiple) {
                        if (option.classList.contains('selected')) {
                            option.classList.remove('selected');
                            answers[key] = answers[key].filter(item => item !== value);
                            return;
                        }

                        if (answers[key].length >= 3) {
                            return;
                        }

                        option.classList.add('selected');
                        answers[key].push(value);
                        return;
                    }

                    options.forEach(item => item.classList.remove('selected'));
                    option.classList.add('selected');
                    answers[key] = value;

                    if (key === 'budget') {
                        runRecommendation();
                    } else {
                        setTimeout(goNext, 180);
                    }
                });
            });
        });

        showStep(0);
    })();
</script>
</body>
</html>
