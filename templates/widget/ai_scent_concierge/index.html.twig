<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>AI Scent Concierge — {{ brand.name }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <style>
        :root {
            --bg: #050505;
            --panel: #111111;
            --ivory: #f7f1e8;
            --muted: #b8afa3;
            --border: rgba(247, 241, 232, 0.16);
            --gold: rgba(247, 241, 232, 0.74);
            --soft-gold: rgba(247, 241, 232, 0.08);
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            background:
                radial-gradient(circle at top, rgba(200, 169, 106, 0.16), transparent 34rem),
                radial-gradient(circle at bottom right, rgba(247, 241, 232, 0.06), transparent 28rem),
                var(--bg);
            color: var(--ivory);
            font-family: Georgia, "Times New Roman", serif;
        }

        button { font-family: inherit; }

        .page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 16px;
        }

        .concierge {
            width: 100%;
            max-width: 1080px;
            border: 1px solid var(--border);
            border-radius: 30px;
            background: rgba(17, 17, 17, 0.95);
            box-shadow: 0 40px 120px rgba(0, 0, 0, 0.52);
            overflow: hidden;
        }

        .header {
            padding: 28px 32px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            gap: 24px;
            align-items: center;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 20px;
            min-width: 0;
        }

        .logo-lockup {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .logo-card {
            width: auto;
            min-width: 0;
            height: auto;
            min-height: 42px;
            border: 0;
            border-radius: 0;
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            padding: 0;
        }

        .logo-card img {
            max-width: 132px;
            max-height: 42px;
            object-fit: contain;
            display: block;
        }

        .partner-logo-card {
            background: transparent;
        }

        .partner-wordmark {
            color: var(--ivory);
            font-size: 16px;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            text-align: left;
            line-height: 1.2;
        }

        .header-copy { min-width: 0; }

        .eyebrow {
            margin: 0 0 8px;
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 0.26em;
            font-size: 11px;
        }

        .brand-name {
            margin: 0;
            font-size: 26px;
            font-weight: 500;
        }

        .brand-subtitle {
            margin: 6px 0 0;
            color: var(--muted);
            font-size: 13px;
        }

        .tag {
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 10px 14px;
            color: var(--muted);
            font-size: 13px;
            white-space: nowrap;
        }

        .header-badge {
            display: grid;
            gap: 10px;
            justify-items: end;
        }

        .powered-by {
            color: rgba(247, 241, 232, 0.34);
            font-size: 11px;
            letter-spacing: 0.08em;
            line-height: 1.3;
            text-align: right;
            white-space: nowrap;
        }

        .content { padding: 44px 32px; }

        .progress {
            height: 1px;
            background: var(--border);
            margin-bottom: 34px;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            background: var(--gold);
            transition: width 240ms ease;
        }

        .step {
            display: none;
            animation: fadeIn 220ms ease-out;
        }

        .step.active { display: block; }

        .center {
            text-align: center;
            max-width: 760px;
            margin: 0 auto;
        }

        h2 {
            margin: 0;
            font-size: 42px;
            line-height: 1.08;
            font-weight: 400;
            letter-spacing: 0;
        }

        .subtitle {
            margin: 20px auto 0;
            max-width: 690px;
            color: var(--muted);
            font-size: 18px;
            line-height: 1.6;
        }

        .question {
            max-width: 860px;
            margin: 0 auto;
        }

        .question h2 {
            font-size: 36px;
            line-height: 1.12;
            letter-spacing: 0;
        }

        .options {
            margin-top: 32px;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }

        .options.compact {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .note-autocomplete {
            margin-top: 32px;
            display: grid;
            gap: 12px;
            max-width: 560px;
        }

        .note-tags {
            display: flex;
            min-height: 34px;
            flex-wrap: wrap;
            gap: 8px;
        }

        .note-tag {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            min-height: 32px;
            border: 1px solid rgba(247, 241, 232, 0.18);
            border-radius: 999px;
            padding: 7px 7px 7px 12px;
            background: rgba(255, 255, 255, 0.035);
            color: rgba(247, 241, 232, 0.82);
            font-size: 13px;
            line-height: 1;
        }

        .note-tag-remove {
            width: 20px;
            height: 20px;
            border: 0;
            border-radius: 999px;
            background: transparent;
            color: rgba(247, 241, 232, 0.58);
            cursor: pointer;
            line-height: 1;
            transition: color 160ms ease, background 160ms ease;
        }

        .note-tag-remove:hover,
        .note-tag-remove:focus-visible {
            background: rgba(247, 241, 232, 0.08);
            color: var(--ivory);
        }

        .note-input-wrap {
            position: relative;
        }

        .note-input {
            width: 100%;
            min-height: 58px;
            border: 1px solid var(--border);
            border-radius: 999px;
            outline: 0;
            background: rgba(255, 255, 255, 0.03);
            color: var(--ivory);
            padding: 16px 19px;
            font: inherit;
            font-size: 15px;
            transition: border-color 180ms ease, background 180ms ease;
        }

        .note-input::placeholder {
            color: rgba(247, 241, 232, 0.38);
        }

        .note-input:focus {
            border-color: var(--gold);
            background: rgba(247, 241, 232, 0.055);
        }

        .note-suggestions {
            position: absolute;
            z-index: 5;
            top: calc(100% + 8px);
            left: 0;
            right: 0;
            display: grid;
            max-height: 220px;
            overflow-y: auto;
            border: 1px solid rgba(247, 241, 232, 0.14);
            border-radius: 22px;
            background: rgba(5, 5, 5, 0.97);
            box-shadow: 0 24px 70px rgba(0, 0, 0, 0.45);
            padding: 7px;
        }

        .note-suggestions[hidden] {
            display: none;
        }

        .note-suggestion {
            width: 100%;
            border: 0;
            border-radius: 999px;
            background: transparent;
            color: rgba(247, 241, 232, 0.75);
            cursor: pointer;
            font: inherit;
            font-size: 14px;
            padding: 11px 14px;
            text-align: left;
            transition: color 160ms ease, background 160ms ease;
        }

        .note-suggestion:hover,
        .note-suggestion:focus-visible {
            background: rgba(247, 241, 232, 0.07);
            color: var(--ivory);
        }

        .note-empty,
        .note-hint {
            margin: 0;
            color: rgba(247, 241, 232, 0.48);
            font-size: 12px;
            line-height: 1.45;
        }

        .context-grid {
            margin-top: 32px;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .context-panel {
            border: 1px solid var(--border);
            border-radius: 22px;
            padding: 18px;
            background: rgba(255, 255, 255, 0.025);
        }

        .context-title {
            margin: 0 0 14px;
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 0.18em;
            font-size: 11px;
        }

        .option {
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.03);
            color: var(--ivory);
            padding: 18px;
            border-radius: 18px;
            cursor: pointer;
            text-align: left;
            font-size: 16px;
            transition: 160ms ease;
            min-height: 58px;
        }

        .option small {
            display: block;
            color: var(--muted);
            margin-top: 6px;
            font-size: 13px;
            line-height: 1.4;
        }

        .option:hover,
        .option.selected {
            border-color: var(--gold);
            background: rgba(200, 169, 106, 0.12);
            transform: translateY(-1px);
        }

        .actions {
            margin-top: 34px;
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn {
            border: 1px solid var(--gold);
            background: var(--ivory);
            color: #050505;
            border-radius: 999px;
            padding: 14px 24px;
            font-size: 15px;
            cursor: pointer;
            transition: 160ms ease;
        }

        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 16px 40px rgba(200, 169, 106, 0.18);
        }

        .btn.secondary {
            background: transparent;
            color: var(--ivory);
            border-color: var(--border);
        }

        .pulse {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            border: 1px solid var(--gold);
            margin: 0 auto 26px;
            position: relative;
        }

        .pulse::after {
            content: "";
            position: absolute;
            inset: -10px;
            border-radius: 50%;
            border: 1px solid rgba(200, 169, 106, 0.32);
            animation: pulse 1.3s infinite;
        }

        .loading-copy {
            margin-top: 28px;
            color: var(--muted);
            font-size: 17px;
        }

        .profile-note {
            max-width: 780px;
            margin: 26px auto 0;
            border: 1px solid var(--border);
            border-radius: 22px;
            padding: 22px;
            background: rgba(200, 169, 106, 0.07);
            color: var(--ivory);
            font-size: 18px;
            line-height: 1.55;
        }

        .results {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
            margin-top: 34px;
        }

        .result-card {
            border: 1px solid var(--border);
            border-radius: 24px;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.035);
        }

        .result-card.hero {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.1fr);
            background:
                linear-gradient(135deg, rgba(200, 169, 106, 0.13), transparent),
                rgba(255, 255, 255, 0.04);
        }

        .result-image {
            min-height: 260px;
            background: rgba(255, 255, 255, 0.04);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .result-image img {
            width: 100%;
            height: 100%;
            max-height: 330px;
            object-fit: contain;
        }

        .image-placeholder {
            width: 100%;
            height: 100%;
            min-height: 220px;
            border: 1px solid var(--border);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(circle at top, rgba(200, 169, 106, 0.18), transparent 55%),
                rgba(255, 255, 255, 0.025);
            color: var(--muted);
            font-size: 13px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .result-body { padding: 24px; }

        .match-line {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
        }

        .match-label {
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 0.18em;
            font-size: 10px;
        }

        .match-percent {
            border: 1px solid rgba(200, 169, 106, 0.42);
            color: var(--gold);
            border-radius: 999px;
            padding: 7px 10px;
            font-size: 13px;
            white-space: nowrap;
        }

        .result-brand {
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.18em;
            font-size: 10px;
            margin-bottom: 8px;
        }

        .result-name {
            font-size: 28px;
            margin: 0;
            font-weight: 400;
        }

        .result-desc {
            color: var(--muted);
            line-height: 1.55;
            font-size: 15px;
            margin-top: 14px;
        }

        .match-copy {
            color: var(--ivory);
            line-height: 1.5;
            font-size: 14px;
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid var(--border);
        }

        .meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: 18px 0;
        }

        .pill {
            border: 1px solid var(--border);
            color: var(--muted);
            border-radius: 999px;
            padding: 6px 9px;
            font-size: 12px;
        }

        .result-link {
            display: inline-flex;
            margin-top: 12px;
            color: #050505;
            background: var(--ivory);
            border-radius: 999px;
            padding: 11px 16px;
            text-decoration: none;
            font-size: 13px;
        }

        .error {
            color: #ffb4a8;
            margin-top: 20px;
            text-align: center;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes pulse {
            from { transform: scale(0.9); opacity: 0.9; }
            to { transform: scale(1.25); opacity: 0; }
        }

        @media (max-width: 900px) {
            .header {
                align-items: flex-start;
                flex-direction: column;
            }

            .header-left {
                align-items: flex-start;
                flex-direction: column;
            }

            .content { padding: 34px 20px; }

            h2 {
                font-size: 30px;
                line-height: 1.12;
            }

            .question h2 {
                font-size: 28px;
                line-height: 1.16;
            }

            .options,
            .options.compact,
            .context-grid,
            .results {
                grid-template-columns: 1fr;
            }

            .result-card.hero {
                grid-template-columns: 1fr;
            }

            .tag { white-space: normal; }

            .header-badge {
                justify-items: start;
            }

            .powered-by {
                text-align: left;
                white-space: normal;
            }
        }
    </style>
</head>

<body>
<div class="page">
    <main class="concierge"
          data-brand-name="{{ brand.name }}"
          data-recommend-url="{{ path('ai_scent_concierge_recommend', { customerName: brand.name }) }}">

        <header class="header">
            <div class="header-left">
                <div class="logo-lockup">
                    <div class="logo-card partner-logo-card">
                        {% if brand.logo %}
                            <img src="{{ asset('uploads/brands/' ~ brand.logo) }}" alt="{{ brand.name }}">
                        {% else %}
                            <span class="partner-wordmark">{{ brand.name }}</span>
                        {% endif %}
                    </div>
                </div>

                <div class="header-copy">
                    <p class="eyebrow">AI Scent Concierge</p>
                    <h1 class="brand-name">{{ brand.name }}</h1>
                    <p class="brand-subtitle">Private AI fragrance consultation</p>
                </div>
            </div>

            <div class="header-badge">
                <div class="tag">Co-created with {{ brand.name }}</div>
                <div class="powered-by">Powered by YourFragrance.AI</div>
            </div>
        </header>

        <section class="content">
            <div class="progress">
                <div class="progress-bar" id="progressBar"></div>
            </div>

            <div class="step active" data-step="0">
                <div class="center">
                    <h2>Your private AI scent consultation.</h2>
                    <p class="subtitle">
                        In less than a minute, your AI Scent Concierge will read your preferences and reveal
                        the {{ brand.name }} fragrance that feels closest to your skin, mood and presence.
                    </p>

                    <div class="actions">
                        <button class="btn" type="button" data-next>Begin the consultation</button>
                    </div>
                </div>
            </div>

            <div class="step" data-step="1">
                <div class="question">
                    <h2>What energy should your fragrance leave behind?</h2>
                    <p class="subtitle">Choose the emotional trail you want people to remember.</p>

                    <div class="options" data-option-group="mood">
                        <button class="option" type="button" data-answer-key="mood" data-value="mysterious">
                            Dark & magnetic
                            <small>Smoky, deep, impossible to fully read.</small>
                        </button>
                        <button class="option" type="button" data-answer-key="mood" data-value="sensual">
                            Warm & addictive
                            <small>Sensual, close to the skin, quietly irresistible.</small>
                        </button>
                        <button class="option" type="button" data-answer-key="mood" data-value="powerful">
                            Bold & commanding
                            <small>Confident, structured, made to be noticed.</small>
                        </button>
                        <button class="option" type="button" data-answer-key="mood" data-value="clean">
                            Fresh & refined
                            <small>Polished, luminous, effortlessly elegant.</small>
                        </button>
                    </div>

                    <div class="actions">
                        <button class="btn" type="button" data-next>Continue</button>
                    </div>
                </div>
            </div>

            <div class="step" data-step="2">
                <div class="question">
                    <h2>Which olfactive world feels closest to you?</h2>
                    <p class="subtitle">Choose up to three worlds your concierge should explore first.</p>

                    <div class="options compact" data-option-group="preferredAccords" data-max="3">
                        <button class="option" type="button" data-answer-key="preferredAccords" data-multiple="true" data-value="AMBER">Amber warmth</button>
                        <button class="option" type="button" data-answer-key="preferredAccords" data-multiple="true" data-value="WOODY">Polished woods</button>
                        <button class="option" type="button" data-answer-key="preferredAccords" data-multiple="true" data-value="OUD">Dark oud</button>
                        <button class="option" type="button" data-answer-key="preferredAccords" data-multiple="true" data-value="LEATHERY">Soft leather</button>
                        <button class="option" type="button" data-answer-key="preferredAccords" data-multiple="true" data-value="SPICY">Warm spices</button>
                        <button class="option" type="button" data-answer-key="preferredAccords" data-multiple="true" data-value="MUSKY">Clean musk</button>
                        <button class="option" type="button" data-answer-key="preferredAccords" data-multiple="true" data-value="CITRUS">Sparkling citrus</button>
                        <button class="option" type="button" data-answer-key="preferredAccords" data-multiple="true" data-value="FLORAL">Modern florals</button>
                        <button class="option" type="button" data-answer-key="preferredAccords" data-multiple="true" data-value="ROSE">Velvet rose</button>
                        <button class="option" type="button" data-answer-key="preferredAccords" data-multiple="true" data-value="GOURMAND">Addictive gourmand</button>
                        <button class="option" type="button" data-answer-key="preferredAccords" data-multiple="true" data-value="SMOKY">Incense & smoke</button>
                        <button class="option" type="button" data-answer-key="preferredAccords" data-multiple="true" data-value="TOBACCO">Tobacco warmth</button>
                    </div>

                    <div class="actions">
                        <button class="btn" type="button" data-next>Continue</button>
                    </div>
                </div>
            </div>

            <div class="step" data-step="3">
                <div class="question">
                    <h2>Which notes are you naturally drawn to?</h2>
                    <p class="subtitle">Select up to three notes your skin usually loves.</p>

                    <div class="note-autocomplete" data-note-picker data-answer-key="lovedNotes" data-max="3">
                        <div class="note-tags" data-note-tags aria-label="Selected preferred notes"></div>
                        <div class="note-input-wrap">
                            <input class="note-input"
                                   type="text"
                                   autocomplete="off"
                                   spellcheck="false"
                                   data-note-input
                                   aria-label="Preferred notes"
                                   aria-autocomplete="list"
                                   placeholder="Type a note — vanilla, iris, sandalwood...">
                            <div class="note-suggestions" data-note-suggestions role="listbox" hidden></div>
                        </div>
                        <p class="note-hint"><span data-note-count>0</span> / 3 selected</p>
                    </div>

                    <div class="actions">
                        <button class="btn" type="button" data-next>Continue</button>
                    </div>
                </div>
            </div>

            <div class="step" data-step="4">
                <div class="question">
                    <h2>Anything your concierge should avoid?</h2>
                    <p class="subtitle">Choose notes you usually dislike, or skip this step.</p>

                    <div class="note-autocomplete" data-note-picker data-answer-key="dislikedNotes" data-max="3">
                        <div class="note-tags" data-note-tags aria-label="Selected avoided notes"></div>
                        <div class="note-input-wrap">
                            <input class="note-input"
                                   type="text"
                                   autocomplete="off"
                                   spellcheck="false"
                                   data-note-input
                                   aria-label="Avoided notes"
                                   aria-autocomplete="list"
                                   placeholder="Type a note — oud, smoke, powder...">
                            <div class="note-suggestions" data-note-suggestions role="listbox" hidden></div>
                        </div>
                        <p class="note-hint"><span data-note-count>0</span> / 3 selected</p>
                    </div>

                    <div class="actions">
                        <button class="btn" type="button" data-next>Continue</button>
                    </div>
                </div>
            </div>

            <div class="step" data-step="5">
                <div class="question">
                    <h2>When should this scent feel most at home?</h2>
                    <p class="subtitle">Tell your concierge the moment and atmosphere you have in mind.</p>

                    <div class="context-grid">
                        <div class="context-panel">
                            <p class="context-title">Moment</p>
                            <div class="options" data-option-group="occasion">
                                <button class="option" type="button" data-answer-key="occasion" data-value="CASUAL">Everyday elegance</button>
                                <button class="option" type="button" data-answer-key="occasion" data-value="WORK">Work & refined presence</button>
                                <button class="option" type="button" data-answer-key="occasion" data-value="DATE">Date night</button>
                                <button class="option" type="button" data-answer-key="occasion" data-value="EVENING">After dark</button>
                                <button class="option" type="button" data-answer-key="occasion" data-value="FORMAL">Black tie / special moments</button>
                                <button class="option" type="button" data-answer-key="occasion" data-value="SPORT">Fresh reset</button>
                            </div>
                        </div>

                        <div class="context-panel">
                            <p class="context-title">Season</p>
                            <div class="options" data-option-group="season">
                                <button class="option" type="button" data-answer-key="season" data-value="SPRING">Spring lightness</button>
                                <button class="option" type="button" data-answer-key="season" data-value="SUMMER">Summer heat</button>
                                <button class="option" type="button" data-answer-key="season" data-value="FALL">Autumn depth</button>
                                <button class="option" type="button" data-answer-key="season" data-value="WINTER">Winter intensity</button>
                            </div>
                        </div>
                    </div>

                    <div class="actions">
                        <button class="btn" type="button" data-next>Continue</button>
                    </div>
                </div>
            </div>

            <div class="step" data-step="6">
                <div class="question">
                    <h2>How should your fragrance live on your skin?</h2>
                    <p class="subtitle">Choose the level of presence you want from your scent.</p>

                    <div class="options" data-option-group="concentration">
                        <button class="option" type="button" data-answer-key="concentration" data-value="EDC">Airy and refreshing</button>
                        <button class="option" type="button" data-answer-key="concentration" data-value="EDT">Soft and close to the skin</button>
                        <button class="option" type="button" data-answer-key="concentration" data-value="EDP">Balanced and elegant</button>
                        <button class="option" type="button" data-answer-key="concentration" data-value="PARFUM">Deep and long-lasting</button>
                        <button class="option" type="button" data-answer-key="concentration" data-value="EXTRAIT">Dense, sensual and lingering</button>
                    </div>

                    <div class="actions">
                        <button class="btn" type="button" data-next>Continue</button>
                    </div>
                </div>
            </div>

            <div class="step" data-step="7">
                <div class="question">
                    <h2>How should the scent be styled?</h2>
                    <p class="subtitle">This only helps your concierge understand the olfactive direction — nothing is locked.</p>

                    <div class="options" data-option-group="gender">
                        <button class="option" type="button" data-answer-key="gender" data-value="FEMALE">More feminine</button>
                        <button class="option" type="button" data-answer-key="gender" data-value="MALE">More masculine</button>
                        <button class="option" type="button" data-answer-key="gender" data-value="UNDISCLOSED">Beyond gender</button>
                        <button class="option" type="button" data-answer-key="gender" data-value="UNDISCLOSED">No preference</button>
                    </div>

                    <div class="actions">
                        <button class="btn" type="button" data-next>Continue</button>
                    </div>
                </div>
            </div>

            <div class="step" data-step="8">
                <div class="question">
                    <h2>What range should your concierge keep in mind?</h2>
                    <p class="subtitle">We will keep the selection aligned with your ideal luxury range.</p>

                    <div class="options" data-option-group="budget">
                        <button class="option" type="button" data-answer-key="budget" data-value="under_100">Under €100</button>
                        <button class="option" type="button" data-answer-key="budget" data-value="100_200">€100–€200</button>
                        <button class="option" type="button" data-answer-key="budget" data-value="200_300">€200–€300</button>
                        <button class="option" type="button" data-answer-key="budget" data-value="300_500">€300–€500</button>
                        <button class="option" type="button" data-answer-key="budget" data-value="500_plus">€500+</button>
                    </div>

                    <div class="actions">
                        <button class="btn" type="button" data-submit>Reveal my matches</button>
                    </div>
                </div>
            </div>

            <div class="step" data-step="9">
                <div class="center">
                    <div class="pulse"></div>
                    <h2>Your AI Scent Concierge is reading your profile...</h2>
                    <p class="loading-copy" id="loadingCopy">Reading your scent profile...</p>
                </div>
            </div>

            <div class="step" data-step="10">
                <div class="center">
                    <p class="eyebrow">Your private selection</p>
                    <h2>Your {{ brand.name }} scent profile.</h2>
                    <p class="subtitle">
                        A curated selection from {{ brand.name }}’s own fragrance universe.
                    </p>
                    <div class="profile-note" id="profileNote"></div>
                </div>

                <div id="results" class="results"></div>

                <div class="actions">
                    <button class="btn secondary" type="button" data-restart>Restart the consultation</button>
                </div>
            </div>

            <div id="error" class="error"></div>
        </section>
    </main>
</div>

<script>
    (() => {
        const root = document.querySelector('.concierge');
        const brandName = root.dataset.brandName;
        const recommendUrl = root.dataset.recommendUrl;
        const steps = Array.from(document.querySelectorAll('.step'));
        const progressBar = document.getElementById('progressBar');
        const resultsContainer = document.getElementById('results');
        const profileNote = document.getElementById('profileNote');
        const errorContainer = document.getElementById('error');

        let currentStep = 0;

        const answers = {
            mood: null,
            preferredAccords: [],
            lovedNotes: [],
            dislikedNotes: [],
            occasion: null,
            season: null,
            concentration: null,
            gender: null,
            budget: null
        };

        const moodToNotes = {
            mysterious: ['Incense', 'Oud', 'Leather'],
            sensual: ['Vanilla', 'Musk', 'Rose'],
            powerful: ['Leather', 'Spices', 'Oud'],
            clean: ['Musk', 'Citrus', 'Bergamot']
        };

        const moodLabels = {
            mysterious: 'dark, magnetic and quietly powerful',
            sensual: 'warm, intimate and addictive',
            powerful: 'bold, confident and unforgettable',
            clean: 'fresh, luminous and quietly refined'
        };

        const accordLabels = {
            AMBER: 'amber warmth',
            WOODY: 'polished woods',
            OUD: 'dark oud',
            LEATHERY: 'soft leather',
            SPICY: 'warm spices',
            MUSKY: 'clean musk',
            CITRUS: 'sparkling citrus',
            FLORAL: 'modern florals',
            ROSE: 'velvet rose',
            GOURMAND: 'addictive gourmand notes',
            SMOKY: 'incense and smoke',
            TOBACCO: 'tobacco warmth'
        };

        const occasionLabels = {
            CASUAL: 'everyday elegance',
            WORK: 'work and refined presence',
            DATE: 'date night',
            EVENING: 'after dark',
            FORMAL: 'black tie moments',
            SPORT: 'a fresh reset'
        };

        const seasonLabels = {
            SPRING: 'spring lightness',
            SUMMER: 'summer heat',
            FALL: 'autumn depth',
            WINTER: 'winter intensity'
        };

        const concentrationLabels = {
            EDC: 'airy and refreshing',
            EDT: 'soft and close to the skin',
            EDP: 'balanced and elegant',
            PARFUM: 'deep and long-lasting',
            EXTRAIT: 'dense, sensual and lingering'
        };

        const budgetMap = {
            under_100: { budget_min: 0, budget_max: 100 },
            '100_200': { budget_min: 100, budget_max: 200 },
            '200_300': { budget_min: 200, budget_max: 300 },
            '300_500': { budget_min: 300, budget_max: 500 },
            '500_plus': { budget_min: 500, budget_max: null }
        };

        const noteSuggestionCache = new Map();
        const notePickerSyncers = [];

        function normalizeNote(value) {
            return String(value || '').replace(/\s+/g, ' ').trim();
        }

        async function fetchNoteSuggestions(query) {
            const cleanQuery = normalizeNote(query);

            if (!cleanQuery) {
                return [];
            }

            const cacheKey = cleanQuery.toLowerCase();

            if (noteSuggestionCache.has(cacheKey)) {
                return noteSuggestionCache.get(cacheKey);
            }

            try {
                const response = await fetch(`/api/notes/suggestions?q=${encodeURIComponent(cleanQuery)}`, {
                    headers: { Accept: 'application/json' }
                });

                if (!response.ok) {
                    return [];
                }

                const data = await response.json();
                const results = Array.isArray(data.results) ? data.results : [];
                noteSuggestionCache.set(cacheKey, results);

                return results;
            } catch (error) {
                return [];
            }
        }

        function initNotePickers() {
            document.querySelectorAll('[data-note-picker]').forEach((picker) => {
                const key = picker.dataset.answerKey;
                const max = Number(picker.dataset.max || 3);
                const tags = picker.querySelector('[data-note-tags]');
                const input = picker.querySelector('[data-note-input]');
                const suggestions = picker.querySelector('[data-note-suggestions]');
                const count = picker.querySelector('[data-note-count]');
                let timer = null;
                let requestId = 0;

                if (!key || !tags || !input || !suggestions || !count) {
                    return;
                }

                const getValues = () => Array.isArray(answers[key]) ? answers[key] : [];
                const hasValue = (note) => getValues().some(item => item.toLowerCase() === note.toLowerCase());

                const hideSuggestions = () => {
                    suggestions.hidden = true;
                    suggestions.innerHTML = '';
                };

                const sync = () => {
                    tags.innerHTML = '';
                    count.textContent = String(getValues().length);

                    getValues().forEach((note) => {
                        const tag = document.createElement('span');
                        tag.className = 'note-tag';
                        tag.textContent = note;

                        const remove = document.createElement('button');
                        remove.type = 'button';
                        remove.className = 'note-tag-remove';
                        remove.setAttribute('aria-label', `Remove ${note}`);
                        remove.textContent = '×';
                        remove.addEventListener('click', () => {
                            answers[key] = getValues().filter(item => item !== note);
                            sync();
                            input.focus({ preventScroll: true });
                        });

                        tag.appendChild(remove);
                        tags.appendChild(tag);
                    });
                };

                const addNote = (value) => {
                    const note = normalizeNote(value);

                    if (!note || hasValue(note) || getValues().length >= max) {
                        return;
                    }

                    answers[key] = [...getValues(), note];
                    input.value = '';
                    hideSuggestions();
                    sync();
                };

                const renderSuggestions = (items) => {
                    suggestions.innerHTML = '';

                    const availableItems = items.filter((item) => {
                        const name = normalizeNote(item.name);
                        return name && !hasValue(name);
                    });

                    if (availableItems.length === 0) {
                        const empty = document.createElement('p');
                        empty.className = 'note-empty';
                        empty.textContent = 'No matching note yet.';
                        suggestions.appendChild(empty);
                        suggestions.hidden = false;
                        return;
                    }

                    availableItems.slice(0, 6).forEach((item) => {
                        const button = document.createElement('button');
                        button.type = 'button';
                        button.className = 'note-suggestion';
                        button.setAttribute('role', 'option');
                        button.textContent = item.family ? `${item.name} · ${item.family}` : item.name;
                        button.addEventListener('click', () => addNote(item.name));
                        suggestions.appendChild(button);
                    });

                    suggestions.hidden = false;
                };

                const requestSuggestions = () => {
                    clearTimeout(timer);
                    timer = setTimeout(async () => {
                        const query = normalizeNote(input.value);

                        if (!query) {
                            hideSuggestions();
                            return;
                        }

                        const currentRequestId = ++requestId;
                        const items = await fetchNoteSuggestions(query);

                        if (currentRequestId !== requestId) {
                            return;
                        }

                        renderSuggestions(items);
                    }, 180);
                };

                input.addEventListener('input', requestSuggestions);
                input.addEventListener('keydown', (event) => {
                    if (event.key === 'Escape') {
                        hideSuggestions();
                        return;
                    }

                    if (event.key === 'Backspace' && input.value === '' && getValues().length > 0) {
                        answers[key] = getValues().slice(0, -1);
                        sync();
                        return;
                    }

                    if (event.key !== 'Enter') {
                        return;
                    }

                    event.preventDefault();
                    const firstSuggestion = suggestions.querySelector('.note-suggestion');

                    if (firstSuggestion) {
                        firstSuggestion.click();
                        return;
                    }

                    addNote(input.value);
                });

                suggestions.addEventListener('mousedown', (event) => {
                    event.preventDefault();
                });

                picker.addEventListener('focusout', () => {
                    setTimeout(() => {
                        if (!picker.contains(document.activeElement)) {
                            hideSuggestions();
                        }
                    }, 0);
                });

                picker.addEventListener('click', () => {
                    input.focus({ preventScroll: true });
                });

                notePickerSyncers.push(sync);
                sync();
            });
        }

        function syncNotePickers() {
            notePickerSyncers.forEach(sync => sync());
        }

        function showStep(index) {
            currentStep = index;

            steps.forEach((step) => {
                step.classList.toggle('active', Number(step.dataset.step) === index);
            });

            const percentage = Math.min(100, Math.round((index / (steps.length - 1)) * 100));
            progressBar.style.width = percentage + '%';
        }

        function goNext() {
            showStep(currentStep + 1);
        }

        function buildPayload() {
            const moodNotes = answers.mood && moodToNotes[answers.mood] ? moodToNotes[answers.mood] : [];
            const preferredNotes = Array.from(new Set([...moodNotes, ...answers.lovedNotes]));
            const budget = answers.budget && budgetMap[answers.budget] ? budgetMap[answers.budget] : {};

            return {
                mood: answers.mood,
                preferred_accords: answers.preferredAccords,
                preferred_notes: preferredNotes,
                disliked_notes: answers.dislikedNotes,
                preferred_occasions: answers.occasion ? [answers.occasion] : [],
                preferred_seasons: answers.season ? [answers.season] : [],
                concentration: answers.concentration,
                gender: answers.gender,
                budget_min: budget.budget_min ?? null,
                budget_max: budget.budget_max ?? null,
                limit: 3,
                maxReasons: 6
            };
        }

        async function runRecommendation() {
            errorContainer.textContent = '';
            showStep(9);

            const loadingLines = [
                'Reading your scent profile...',
                'Interpreting your olfactive world...',
                'Balancing notes, accords and skin presence...',
                `Selecting your ${brandName} fragrances...`
            ];

            let lineIndex = 0;
            const loadingCopy = document.getElementById('loadingCopy');
            const loadingInterval = setInterval(() => {
                lineIndex = (lineIndex + 1) % loadingLines.length;
                loadingCopy.textContent = loadingLines[lineIndex];
            }, 700);

            try {
                await new Promise(resolve => setTimeout(resolve, 1500));

                const response = await fetch(recommendUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(buildPayload())
                });

                const data = await response.json();

                clearInterval(loadingInterval);

                if (!response.ok || !data.ok) {
                    throw new Error(data.message || 'Unable to generate recommendations.');
                }

                profileNote.textContent = buildProfileSummary();
                renderResults(data.results || []);
                showStep(10);
            } catch (error) {
                clearInterval(loadingInterval);
                errorContainer.textContent = error.message || 'Something went wrong.';
                showStep(8);
            }
        }

        function buildProfileSummary() {
            const mood = moodLabels[answers.mood] || 'distinctive and personal';
            const accords = answers.preferredAccords.length
                ? formatList(answers.preferredAccords.map(value => accordLabels[value] || value.toLowerCase()))
                : 'a nuanced olfactive world';

            const notes = answers.lovedNotes.length
                ? formatList(answers.lovedNotes)
                : 'a personal scent signature';

            const occasion = answers.occasion ? occasionLabels[answers.occasion] : 'your chosen moment';
            const season = answers.season ? seasonLabels[answers.season] : 'your preferred atmosphere';
            const concentration = answers.concentration ? concentrationLabels[answers.concentration] : 'your ideal skin presence';

            return `Your profile leans ${mood}, drawn toward ${accords} and ${notes}. Your concierge selected fragrances designed for ${occasion}, ${season}, and a ${concentration} presence.`;
        }

        function renderResults(results) {
            resultsContainer.innerHTML = '';

            if (!results.length) {
                resultsContainer.innerHTML = `
                    <div class="result-card" style="grid-column: 1 / -1;">
                        <div class="result-body">
                            <h3 class="result-name">No match found yet.</h3>
                            <p class="result-desc">
                                Try adjusting your answers to reveal more fragrance matches.
                            </p>
                        </div>
                    </div>
                `;
                return;
            }

            const maxScore = Math.max(...results.map(item => Number(item.score || 0)));

            results.forEach((item, index) => {
                const percent = computeMatchPercent(item, index, maxScore);
                const matchLabel = index === 0 ? 'Signature match' : 'Curated alternative';
                const matchCopy = item.conciergeReason || buildMatchCopy(item, percent);

                const price = item.listPriceCents !== null && item.listPriceCents !== undefined
                    ? `${(item.listPriceCents / 100).toFixed(2)} ${item.listPriceCurrency || 'EUR'}`
                    : null;

                const description = item.shortDescription || item.description || 'A fragrance selected by your AI Scent Concierge.';

                const image = item.imageUrl
                    ? `<img src="${escapeHtml(item.imageUrl)}" alt="${escapeHtml(item.name)}">`
                    : `<div class="image-placeholder">Image coming soon</div>`;

                const cta = item.productUrl
                    ? `<a class="result-link" href="${escapeHtml(item.productUrl)}" target="_blank" rel="noopener noreferrer">Explore the scent</a>`
                    : '';

                resultsContainer.innerHTML += `
                    <article class="result-card ${index === 0 ? 'hero' : ''}">
                        <div class="result-image">
                            ${image}
                        </div>

                        <div class="result-body">
                            <div class="match-line">
                                <span class="match-label">${matchLabel}</span>
                                <span class="match-percent">${percent}% match</span>
                            </div>

                            <div class="result-brand">${escapeHtml(item.brand || brandName)}</div>
                            <h3 class="result-name">${escapeHtml(item.name)}</h3>
                            <p class="result-desc">${escapeHtml(description)}</p>

                            <div class="meta">
                                ${item.concentration ? `<span class="pill">${escapeHtml(item.concentration)}</span>` : ''}
                                ${price ? `<span class="pill">${escapeHtml(price)}</span>` : ''}
                            </div>

                            <p class="match-copy">${escapeHtml(matchCopy)}</p>
                            ${cta}
                        </div>
                    </article>
                `;
            });
        }

        function computeMatchPercent(item, index, maxScore) {
            const score = Number(item.score || 0);

            if (!maxScore || !score) {
                return [96, 91, 87][index] || 84;
            }

            const normalized = Math.max(0, Math.min(1, score / maxScore));
            const percent = Math.round(84 + normalized * 12 - index * 2);

            return Math.max(78, Math.min(97, percent));
        }

        function buildMatchCopy(item, percent) {
            const selectedNotes = answers.lovedNotes.length ? formatList(answers.lovedNotes) : null;
            const mood = moodLabels[answers.mood] || 'your personal scent direction';

            if (selectedNotes) {
                return `${percent}% aligned with your ${mood} profile and your attraction to ${selectedNotes}.`;
            }

            return `${percent}% aligned with your ${mood} profile and the presence you asked your concierge to keep in mind.`;
        }

        function formatList(items) {
            const clean = items.filter(Boolean);

            if (clean.length === 0) {
                return '';
            }

            if (clean.length === 1) {
                return clean[0];
            }

            if (clean.length === 2) {
                return `${clean[0]} and ${clean[1]}`;
            }

            return `${clean.slice(0, -1).join(', ')} and ${clean[clean.length - 1]}`;
        }

        function escapeHtml(value) {
            return String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        function resetAnswers() {
            answers.mood = null;
            answers.preferredAccords = [];
            answers.lovedNotes = [];
            answers.dislikedNotes = [];
            answers.occasion = null;
            answers.season = null;
            answers.concentration = null;
            answers.gender = null;
            answers.budget = null;
        }

        document.querySelectorAll('[data-next]').forEach(button => {
            button.addEventListener('click', goNext);
        });

        document.querySelectorAll('[data-submit]').forEach(button => {
            button.addEventListener('click', runRecommendation);
        });

        document.querySelectorAll('[data-restart]').forEach(button => {
            button.addEventListener('click', () => {
                resetAnswers();

                document.querySelectorAll('.option.selected').forEach(option => {
                    option.classList.remove('selected');
                });

                syncNotePickers();
                resultsContainer.innerHTML = '';
                profileNote.textContent = '';
                errorContainer.textContent = '';
                showStep(0);
            });
        });

        document.querySelectorAll('.option[data-answer-key]').forEach(option => {
            option.addEventListener('click', () => {
                const key = option.dataset.answerKey;
                const value = option.dataset.value;
                const multiple = option.dataset.multiple === 'true';
                const group = option.closest('[data-option-group]');

                if (!key || !value) {
                    return;
                }

                if (multiple) {
                    const max = Number(group?.dataset.max || 3);
                    const current = Array.isArray(answers[key]) ? answers[key] : [];

                    if (option.classList.contains('selected')) {
                        option.classList.remove('selected');
                        answers[key] = current.filter(item => item !== value);
                        return;
                    }

                    if (current.length >= max) {
                        return;
                    }

                    option.classList.add('selected');
                    answers[key] = [...current, value];
                    return;
                }

                if (group) {
                    group.querySelectorAll('.option.selected').forEach(item => {
                        item.classList.remove('selected');
                    });
                }

                option.classList.add('selected');
                answers[key] = value;
            });
        });

        initNotePickers();
        showStep(0);
    })();
</script>
</body>
</html>
