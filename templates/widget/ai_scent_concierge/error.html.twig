<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>AI Scent Concierge unavailable</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <style>
        :root {
            --bg: #020202;
            --ivory: #f7f1e8;
            --muted: rgba(247, 241, 232, 0.58);
            --line: rgba(247, 241, 232, 0.14);
            --serif: "Cormorant Garamond", Georgia, "Times New Roman", serif;
        }

        * {
            box-sizing: border-box;
        }

        body {
            display: grid;
            min-height: 100dvh;
            margin: 0;
            place-items: center;
            background:
                radial-gradient(ellipse 24rem 11rem at 18% 72%, rgba(255, 255, 255, 0.12), transparent 74%),
                var(--bg);
            color: var(--ivory);
            font-family: var(--serif);
        }

        main {
            width: min(100% - 2rem, 32rem);
            padding: 3rem 0;
            text-align: center;
        }

        p:first-child {
            margin: 0 0 1rem;
            color: rgba(247, 241, 232, 0.42);
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }

        h1 {
            margin: 0;
            color: var(--ivory);
            font-size: clamp(2.6rem, 9vw, 4.8rem);
            font-weight: 400;
            line-height: 0.95;
        }

        p {
            margin: 1.4rem auto 0;
            color: var(--muted);
            font-size: 1.05rem;
            font-weight: 500;
            line-height: 1.55;
        }

        .powered {
            margin-top: 2.2rem;
            padding-top: 1.2rem;
            border-top: 1px solid var(--line);
            color: rgba(247, 241, 232, 0.34);
            font-size: 0.78rem;
        }
    </style>
</head>
<body>
    <main>
        <p>AI Scent Concierge</p>
        <h1>Concierge unavailable.</h1>
        <p>
            The fragrance consultation for {{ customerName }} is not available yet.
            Please check the partner name and try again.
        </p>
        <p class="powered">Powered by YourFragrance.AI</p>
    </main>
</body>
</html>
