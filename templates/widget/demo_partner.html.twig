<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ partner }} | Concierge demo</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <style>
        :root {
            --black: #040404;
            --ivory: #f7f1e8;
            --muted: rgba(247, 241, 232, 0.58);
            --line: rgba(247, 241, 232, 0.16);
            --serif: "Cormorant Garamond", Georgia, "Times New Roman", serif;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            background:
                radial-gradient(ellipse 28rem 12rem at 20% 78%, rgba(255, 255, 255, 0.14), transparent 72%),
                linear-gradient(180deg, #060606 0%, var(--black) 100%);
            color: var(--ivory);
            font-family: var(--serif);
        }

        main {
            display: grid;
            min-height: 100vh;
            grid-template-rows: auto 1fr auto;
        }

        header,
        footer {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            padding: 1.4rem clamp(1.2rem, 4vw, 3rem);
            color: rgba(247, 241, 232, 0.52);
            font-size: 0.82rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        section {
            display: grid;
            width: min(100% - 2rem, 72rem);
            margin: 0 auto;
            align-content: center;
            padding: 4rem 0;
        }

        p {
            max-width: 34rem;
            margin: 1.2rem 0 0;
            color: var(--muted);
            font-size: 1.18rem;
            line-height: 1.55;
        }

        h1 {
            max-width: 12ch;
            margin: 0;
            color: var(--ivory);
            font-size: clamp(4rem, 10vw, 8rem);
            font-weight: 400;
            line-height: 0.88;
        }

        button {
            width: fit-content;
            min-height: 3rem;
            margin-top: 2rem;
            padding: 0.78rem 1.5rem;
            border: 1px solid rgba(247, 241, 232, 0.42);
            border-radius: 999px;
            background: transparent;
            color: var(--ivory);
            font: 500 1rem/1 var(--serif);
            cursor: pointer;
            transition: border-color 220ms ease, opacity 220ms ease, transform 220ms ease;
        }

        button:hover,
        button:focus-visible {
            border-color: rgba(247, 241, 232, 0.84);
            transform: translateY(-1px);
        }

        code {
            display: block;
            width: min(100%, 43rem);
            margin-top: 2rem;
            padding: 1rem;
            border: 1px solid var(--line);
            border-radius: 1rem;
            color: rgba(247, 241, 232, 0.58);
            font: 0.82rem/1.55 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            white-space: pre-wrap;
        }
    </style>
</head>
<body>
    <main>
        <header>
            <span>{{ partner }}</span>
            <span>Private fragrance house</span>
        </header>

        <section>
            <h1>An edited world of scent.</h1>
            <p>
                This page simulates a luxury partner website. The concierge below is loaded only through
                the public script snippet, with no direct API calls or widget logic on the partner page.
            </p>

            <button id="find-my-scent" type="button">Find your scent</button>

            {% if app.request.query.get('floating') %}
                <code>&lt;script src=&quot;{{ absolute_url(asset('concierge.js')) }}&quot; data-partner=&quot;{{ partner }}&quot;&gt;&lt;/script&gt;</code>
            {% else %}
                <code>&lt;button id=&quot;find-my-scent&quot;&gt;Find your scent&lt;/button&gt;
&lt;script src=&quot;{{ absolute_url(asset('concierge.js')) }}&quot; data-partner=&quot;{{ partner }}&quot; data-trigger=&quot;#find-my-scent&quot;&gt;&lt;/script&gt;</code>
            {% endif %}
        </section>

        <footer>
            <span>Fine fragrance</span>
            <span>{{ "now"|date("Y") }}</span>
        </footer>
    </main>

    {% if app.request.query.get('floating') %}
        <script src="{{ asset('concierge.js') }}" data-partner="{{ partner }}"></script>
    {% else %}
        <script src="{{ asset('concierge.js') }}" data-partner="{{ partner }}" data-trigger="#find-my-scent"></script>
    {% endif %}
</body>
</html>
