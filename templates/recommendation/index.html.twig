{% extends 'base.html.twig' %}

{% block title %}Find your scent | YFAI{% endblock %}

{% block body %}
    <main class="yfai-home yfai-quiz-page" data-yfai-quiz data-recommend-url="{{ path('api_quiz_recommendations') }}">
        <div class="yfai-menu-shell" data-yfai-menu>
            <button class="yfai-menu-toggle" type="button" aria-label="Open navigation" aria-controls="yfai-menu-panel" aria-expanded="false" data-yfai-menu-toggle>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </button>

            <button class="yfai-menu-backdrop" type="button" aria-label="Close navigation" data-yfai-menu-close></button>

            <aside class="yfai-menu-panel" id="yfai-menu-panel" aria-hidden="true" aria-label="YFAI navigation" tabindex="-1">
                <span class="yfai-menu-kicker">Menu</span>

                <nav class="yfai-menu-nav" aria-label="Primary navigation">
                    <a class="yfai-menu-link" href="{{ path('home') }}">
                        <span>01</span>
                        <strong>Home</strong>
                    </a>
                    <a class="yfai-menu-link" href="{{ path('recommendation_form') }}">
                        <span>02</span>
                        <strong>Find your scent</strong>
                    </a>
                </nav>
            </aside>
        </div>

        <section class="yfai-quiz" aria-labelledby="yfai-quiz-title">
            <video class="yfai-ambient-video" playsinline autoplay muted loop>
                <source src="{{ asset('/home/bgloop.webm') }}" type="video/webm">
            </video>

            <span class="yfai-mote yfai-mote-one" aria-hidden="true"></span>
            <span class="yfai-mote yfai-mote-two" aria-hidden="true"></span>
            <span class="yfai-mote yfai-mote-three" aria-hidden="true"></span>

            <a class="yfai-logo yfai-quiz-logo" href="{{ path('home') }}" aria-label="YFAI home">YF</a>

            <div class="yfai-quiz-shell">
                <div class="yfai-quiz-meta" aria-label="Quiz controls">
                    <span class="yfai-quiz-progress" data-yfai-progress>01 / 08</span>
                    <button class="yfai-quiz-back" type="button" data-yfai-back disabled>Back</button>
                </div>

                <div class="yfai-quiz-panel" data-yfai-question-panel aria-live="polite">
                    <p class="yfai-quiz-kicker">Find your scent</p>
                    <h1 id="yfai-quiz-title" data-yfai-question-title></h1>
                    <p class="yfai-quiz-subtitle" data-yfai-question-subtitle></p>
                    <div class="yfai-quiz-options" data-yfai-options></div>
                    <p class="yfai-quiz-error" role="alert" data-yfai-error></p>
                    <button class="yfai-quiz-next" type="button" data-yfai-next hidden>Continue</button>
                </div>

                <div class="yfai-quiz-loading" data-yfai-loading aria-live="polite" hidden>
                    <p class="yfai-quiz-kicker">Consultation</p>
                    <h2>Composing your scent profile.</h2>
                    <p data-yfai-loading-line>Reading your olfactive preferences.</p>
                </div>

                <section class="yfai-quiz-results" data-yfai-results aria-live="polite" hidden>
                    <div class="yfai-results-heading">
                        <p class="yfai-quiz-kicker">Your closest signatures</p>
                        <h2>Your fragrance edit</h2>
                        <button class="yfai-results-restart" type="button" data-yfai-restart>Restart the consultation</button>
                    </div>
                    <div class="yfai-results-list" data-yfai-results-list></div>
                </section>
            </div>

            <noscript>
                <p class="yfai-quiz-noscript">Please enable JavaScript to begin the YFAI scent consultation.</p>
            </noscript>
        </section>

        {% include 'web/_footer.html.twig' %}
    </main>
{% endblock %}
