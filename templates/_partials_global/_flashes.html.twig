{# Tailwind flash messages. Call with: include this partial once near the top of main content. #}
{% set styles = {
    'success': 'bg-green-50 text-green-800 border-green-200',
    'error'  : 'bg-red-50 text-red-800 border-red-200',
    'danger' : 'bg-red-50 text-red-800 border-red-200',
    'warning': 'bg-yellow-50 text-yellow-800 border-yellow-200',
    'info'   : 'bg-blue-50 text-blue-800 border-blue-200',
    'notice' : 'bg-blue-50 text-blue-800 border-blue-200'
} %}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 space-y-3">
    {% for type, messages in app.flashes %}
        {% set cls = styles[type]|default('bg-gray-50 text-gray-800 border-gray-200') %}
        {% for message in messages %}
            <div class="border {{ cls }} rounded-md px-4 py-3 text-sm">
                {{ message|raw }}
            </div>
        {% endfor %}
    {% endfor %}
</div>
