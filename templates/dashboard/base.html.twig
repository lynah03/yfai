<!doctype html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}YFAI Platform{% endblock %}</title>

    {% block stylesheets %}
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&display=swap">
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block head %}
        {% include '_partials_global/_favicons.html.twig' %}
    {% endblock %}
</head>

<body class="yfai-dashboard">

{% block header %}
    {% set current_route = app.request.attributes.get('_route') %}
    {% set nav_items = [
        { 'label': 'Dashboard',      'route': 'dashboard_index_home',         'prefix': 'dashboard_index' },
        { 'label': 'Brands',         'route': 'dashboard_brand_index',         'prefix': 'dashboard_brand_' },
        { 'label': 'Perfumes',       'route': 'dashboard_perfume_index',       'prefix': 'dashboard_perfume_', 'exclude': 'dashboard_perfume_note_' },
        { 'label': 'Perfume notes',  'route': 'dashboard_perfume_note_index',  'prefix': 'dashboard_perfume_note_' },
        { 'label': 'Users',          'route': 'dashboard_user_profile_index',  'prefix': 'dashboard_user_profile_' },
        { 'label': 'Employees',      'route': 'dashboard_employee_index',      'prefix': 'dashboard_employee_' },
        { 'label': 'Integration',    'route': 'dashboard_integration_index',   'prefix': 'dashboard_integration_' }
    ] %}

    <header class="yfai-dashboard-header">
        <div class="yfai-dashboard-header-inner">
            <a href="{{ path('dashboard_index_home') }}" class="yfai-dashboard-brand" aria-label="YFAI dashboard home">
                <img src="{{ asset('images/YFAI1.png') }}" alt="YF">
            </a>

            <nav class="yfai-dashboard-nav" aria-label="Dashboard navigation">
                {% for item in nav_items %}
                    {% set is_active = current_route starts with item.prefix and (item.exclude is not defined or not (current_route starts with item.exclude)) %}
                    <a href="{{ path(item.route) }}"
                       class="{{ is_active ? 'is-active' : '' }}"
                       {% if is_active %}aria-current="page"{% endif %}>
                        {{ item.label }}
                    </a>
                {% endfor %}

                {% if app.user %}
                    <a href="{{ path('app_dashboard_logout') }}" class="yfai-dashboard-logout">Logout</a>
                {% endif %}
            </nav>
        </div>
    </header>
{% endblock %}

{# Hooks optionnels, laissés vides #}
{% block contextnavbar %}{% endblock %}
{% block hero %}{% endblock %}
{% block topwarper %}{% endblock %}
{% block dashboard %}{% endblock %}

<main id="content" class="yfai-dashboard-shell">
    {% include '_partials_global/_flashes.html.twig' %}

    <div class="yfai-dashboard-container">
        <section class="yfai-dashboard-panel" aria-label="Dashboard content">
            {% block body %}{% endblock %}
        </section>
    </div>
</main>

{% block footer %}
    {% include '_partials_global/_page_footer.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
{% endblock %}
{% block scripts %}{% endblock %}
{% block footersctipts %}{% endblock %}

</body>
</html>
