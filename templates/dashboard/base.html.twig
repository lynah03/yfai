<!doctype html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8"> <title>{% block title %}yfAi Dashboard{% endblock %}</title>
    {# <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>"> #} {# Run composer require symfony/webpack-encore-bundle to start using Symfony UX #} {% block stylesheets %} {{ encore_entry_link_tags('app') }} {{ encore_entry_link_tags('app') }}
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <script src="https://code.jquery.com/jquery-3.2.1.min.js"></script>
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {# <script src="https://cdn.jsdelivr.net/gh/xcash/bootstrap-autocomplete@v2.3.7/dist/latest/bootstrap-autocomplete.min.js"></script> #}
        {{ encore_entry_link_tags('app') }} {# <link rel="stylesheet" href="assets/styles/custom.css"> #}
    {% endblock %}
    {% block head %}
        {% include '_partials_global/_favicons.html.twig' %}
    {% endblock %}


</head>
<body class="min-h-screen bg-gray-50 text-gray-900 pb-16">

{% block header %}
    {% include '_partials_global/_header.html.twig' with {
        brandName: 'yfAi',
        logoPath: asset('images/YFAI.png'),
        menu: [
            { label: 'Dashboard', route: 'dashboard_index_home' },
            { label: 'Brands',  route: 'dashboard_brand_index' },
            { label: 'Users',     route: 'dashboard_index_home' }
        ]
    } %}
{% endblock %}

{% block contextnavbar %}{% endblock %}
{% block hero %}{% endblock %}
{% block topwarper %}{% endblock %}
{% block dashboard %}{% endblock %}

<main id="content" class="px-4 md:px-0">
    {% include '_partials_global/_flashes.html.twig' %}
    <div class="max-w-7xl mx-auto">
        <div class="p-1 md:p-4 border border-gray-200 rounded-lg bg-white shadow-sm">
            {% block body %}{% endblock %}
        </div>
    </div>
</main>

{% block footer %}
    {% include '_partials_global/_page_footer.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
{% endblock %}
{% block scripts %}{% endblock %}
{% block footersctipts %}{% endblock %}
</body>
</html>
