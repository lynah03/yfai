{% extends 'dashboard/base.html.twig' %}

{% block title %}New UserProfile{% endblock %}

{% block body %}
    <section class="dashboard-page">
        <header class="dashboard-form-header">
            <div>
                <p class="dashboard-page-kicker">Audience profiles</p>
                <h1 class="dashboard-title">Create user profile</h1>
                <p class="dashboard-subtitle">Add an end-user profile for recommendation testing and account management.</p>
            </div>

            <div class="dashboard-actions">
                <a href="{{ path('dashboard_user_profile_index') }}" class="dashboard-button secondary">Back to profiles</a>
            </div>
        </header>

        <div class="yfai-form-card">
            <div class="card-body">
                {{ include('dashboard/user_profile/_form.html.twig') }}
            </div>
        </div>
    </section>
{% endblock %}
