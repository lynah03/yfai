{% extends 'dashboard/base.html.twig' %}

{% block title %}UserProfile{% endblock %}

{% block body %}
    <h1>UserProfile</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ user_profile.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ user_profile.name }}</td>
            </tr>
            <tr>
                <th>Gender</th>
                <td>{{ user_profile.gender }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ user_profile.createdAt ? user_profile.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ user_profile.updatedAt ? user_profile.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Password</th>
                <td>{{ user_profile.password }}</td>
            </tr>
            <tr>
                <th>IsVerified</th>
                <td>{{ user_profile.isVerified ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Roles</th>
                <td>{{ user_profile.roles ? user_profile.roles|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ user_profile.email }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_user_profile_index') }}">back to list</a>

    <a href="{{ path('app_user_profile_edit', {'id': user_profile.id}) }}">edit</a>

    {{ include('user_profile/_delete_form.html.twig') }}
{% endblock %}
