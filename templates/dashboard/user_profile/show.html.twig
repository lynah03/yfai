{% extends 'dashboard/base.html.twig' %}

{% block title %}UserProfile{% endblock %}

{% block body %}
    <section class="dashboard-page">
        <header class="dashboard-form-header">
            <div>
                <p class="dashboard-page-kicker">Audience profiles</p>
                <h1 class="dashboard-title">{{ user_profile.email ?: user_profile.name ?: 'User profile' }}</h1>
                <p class="dashboard-subtitle">Review this profile's account and matching metadata.</p>
            </div>

            <div class="dashboard-actions">
                <a href="{{ path('dashboard_user_profile_index') }}" class="dashboard-button secondary">Back to profiles</a>
                <a href="{{ path('dashboard_user_profile_edit', {'id': user_profile.id}) }}" class="dashboard-button">Edit profile</a>
                {{ include('dashboard/user_profile/_delete_form.html.twig') }}
            </div>
        </header>

        <div class="table-shell">
            <table>
                <tbody>
            <tr>
                <th>Id</th>
                <td>{{ user_profile.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ user_profile.name }}</td>
            </tr>
            <tr>
                <th>Gender</th>
                <td>{{ user_profile.gender }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ user_profile.createdAt ? user_profile.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ user_profile.updatedAt ? user_profile.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Password</th>
                <td>{{ user_profile.password }}</td>
            </tr>
            <tr>
                <th>IsVerified</th>
                <td>{{ user_profile.isVerified ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Roles</th>
                <td>{{ user_profile.roles ? user_profile.roles|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ user_profile.email }}</td>
            </tr>
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
