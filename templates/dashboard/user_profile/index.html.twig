{% extends 'dashboard/base.html.twig' %}

{% block title %}UserProfile index{% endblock %}

{% block body %}
    <h1>UserProfile index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Gender</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>Password</th>
                <th>IsVerified</th>
                <th>Roles</th>
                <th>Email</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user_profile in user_profiles %}
            <tr>
                <td>{{ user_profile.id }}</td>
                <td>{{ user_profile.name }}</td>
                <td>{{ user_profile.gender }}</td>
                <td>{{ user_profile.createdAt ? user_profile.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ user_profile.updatedAt ? user_profile.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ user_profile.password }}</td>
                <td>{{ user_profile.isVerified ? 'Yes' : 'No' }}</td>
                <td>{{ user_profile.roles ? user_profile.roles|json_encode : '' }}</td>
                <td>{{ user_profile.email }}</td>
                <td>
                    <a href="{{ path('app_user_profile_show', {'id': user_profile.id}) }}">show</a>
                    <a href="{{ path('app_user_profile_edit', {'id': user_profile.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_user_profile_new') }}">Create new</a>
{% endblock %}
