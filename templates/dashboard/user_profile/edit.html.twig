{% extends 'dashboard/base.html.twig' %}

{% block title %}Edit UserProfile{% endblock %}

{% block body %}
    <section class="dashboard-page">
        <header class="dashboard-form-header">
            <div>
                <p class="dashboard-page-kicker">Audience profiles</p>
                <h1 class="dashboard-title">Edit user profile</h1>
                <p class="dashboard-subtitle">Update account details without changing the underlying profile model.</p>
            </div>

            <div class="dashboard-actions">
                <a href="{{ path('dashboard_user_profile_index') }}" class="dashboard-button secondary">Back to profiles</a>
                {{ include('dashboard/user_profile/_delete_form.html.twig') }}
            </div>
        </header>

        <div class="yfai-form-card">
            <div class="card-body">
                {{ include('dashboard/user_profile/_form.html.twig', {'button_label': 'Update'}) }}
            </div>
        </div>
    </section>
{% endblock %}
