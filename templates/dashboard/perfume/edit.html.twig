{% extends 'dashboard/base.html.twig' %}

{% block title %}Edit Perfume{% endblock %}

{% block body %}
    <section class="dashboard-page">
        <header class="dashboard-form-header">
            <div>
                <p class="dashboard-page-kicker">Fragrance catalog</p>
                <h1 class="dashboard-title">Edit perfume</h1>
                <p class="dashboard-subtitle">Refine the catalog details used by the AI scent concierge.</p>
            </div>

            <div class="dashboard-actions">
                <a href="{{ path('dashboard_perfume_index') }}" class="dashboard-button secondary">Back to perfumes</a>
            </div>
        </header>

        <div class="yfai-form-card">
            <div class="card-body">
                {{ include('dashboard/perfume/_form.html.twig', {'button_label': 'Update'}) }}
            </div>
        </div>
    </section>
{% endblock %}
