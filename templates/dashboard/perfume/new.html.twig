{% extends 'dashboard/base.html.twig' %}

{% block title %}New Perfume{% endblock %}

{% block body %}
    <section class="dashboard-page">
        <header class="dashboard-form-header">
            <div>
                <p class="dashboard-page-kicker">Fragrance catalog</p>
                <h1 class="dashboard-title">Create perfume</h1>
                <p class="dashboard-subtitle">Add product copy, catalog metadata and recommendation-ready attributes.</p>
            </div>

            <div class="dashboard-actions">
                <a href="{{ path('dashboard_perfume_index') }}" class="dashboard-button secondary">Back to perfumes</a>
            </div>
        </header>

        <div class="yfai-form-card">
            <div class="card-body">
                {{ include('dashboard/perfume/_form.html.twig') }}
            </div>
        </div>
    </section>
{% endblock %}
