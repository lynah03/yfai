{% extends 'dashboard/base.html.twig' %}

{% block title %}Note{% endblock %}

{% block body %}
    <section class="dashboard-page">
        <header class="dashboard-form-header">
            <div>
                <p class="dashboard-page-kicker">Olfactive library</p>
                <h1 class="dashboard-title">{{ note.name }}</h1>
                <p class="dashboard-subtitle">{{ note.description ?: 'No note description has been added yet.' }}</p>
            </div>

            <div class="dashboard-actions">
                <a href="{{ path('dashboard_note_index') }}" class="dashboard-button secondary">Back to notes</a>
                <a href="{{ path('dashboard_note_edit', {'id': note.id}) }}" class="dashboard-button">Edit note</a>
                {{ include('dashboard/note/_delete_form.html.twig') }}
            </div>
        </header>

        <div class="table-shell">
            <table>
                <tbody>
            <tr>
                <th>Id</th>
                <td>{{ note.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ note.name }}</td>
            </tr>
            <tr>
                <th>Family</th>
                <td>{{ note.family }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ note.description }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ note.createdAt ? note.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ note.updatedAt ? note.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
