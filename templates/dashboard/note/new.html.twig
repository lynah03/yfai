{% extends 'dashboard/base.html.twig' %}

{% block title %}New Note{% endblock %}

{% block body %}
    <section class="dashboard-page">
        <header class="dashboard-form-header">
            <div>
                <p class="dashboard-page-kicker">Olfactive library</p>
                <h1 class="dashboard-title">Create note</h1>
                <p class="dashboard-subtitle">Add a note that can be used by perfumes, quizzes and scent matching.</p>
            </div>

            <div class="dashboard-actions">
                <a href="{{ path('dashboard_note_index') }}" class="dashboard-button secondary">Back to notes</a>
            </div>
        </header>

        <div class="yfai-form-card">
            <div class="card-body">
                {{ include('dashboard/note/_form.html.twig') }}
            </div>
        </div>
    </section>
{% endblock %}
