{% extends 'dashboard/base.html.twig' %}

{% block title %}Edit Note{% endblock %}

{% block body %}
    <section class="dashboard-page">
        <header class="dashboard-form-header">
            <div>
                <p class="dashboard-page-kicker">Olfactive library</p>
                <h1 class="dashboard-title">Edit note</h1>
                <p class="dashboard-subtitle">Refine the note name, family and description used in matching.</p>
            </div>

            <div class="dashboard-actions">
                <a href="{{ path('dashboard_note_index') }}" class="dashboard-button secondary">Back to notes</a>
                {{ include('dashboard/note/_delete_form.html.twig') }}
            </div>
        </header>

        <div class="yfai-form-card">
            <div class="card-body">
                {{ include('dashboard/note/_form.html.twig', {'button_label': 'Update'}) }}
            </div>
        </div>
    </section>
{% endblock %}
