{% extends 'custom-base.html.twig' %}

{% block title %}YFAI Dashboard Login{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&display=swap">
    {{ encore_entry_link_tags('app') }}
    <style>
        body.ltr.error-bg,
        .login-img,
        .login-img .page {
            background: #020202 !important;
            color: rgba(247, 241, 232, 0.94);
            font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
        }

        .login-img {
            min-height: 100vh;
            display: block;
            overflow: hidden;
        }

        .login-img::before,
        .login-img::after {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
        }

        .login-img::before {
            background:
                radial-gradient(ellipse 14rem 25rem at -2% 40%, rgba(255, 255, 255, 0.32), rgba(255, 255, 255, 0.08) 36%, transparent 68%),
                radial-gradient(ellipse 28rem 12rem at 36% 34%, rgba(255, 255, 255, 0.1), transparent 74%),
                radial-gradient(ellipse 20rem 9rem at 86% 20%, rgba(255, 255, 255, 0.11), transparent 72%);
            filter: blur(18px);
            opacity: 0.42;
            animation: yfai-login-smoke 13s ease-in-out infinite;
        }

        .login-img::after {
            inset: -18% -12%;
            background:
                conic-gradient(from 118deg at 49% 44%, transparent 0deg, rgba(255, 255, 255, 0.1) 38deg, transparent 84deg, rgba(255, 255, 255, 0.055) 144deg, transparent 214deg),
                radial-gradient(ellipse at 18% 52%, rgba(255, 255, 255, 0.18), transparent 58%);
            filter: blur(24px);
            opacity: 0.2;
        }

        .dashboard-login {
            position: relative;
            z-index: 1;
            width: min(100% - 2rem, 28rem);
            margin: 0 auto;
            padding: 4rem 0;
        }

        .dashboard-login-card {
            border: 1px solid rgba(247, 241, 232, 0.16);
            border-radius: 1.25rem;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.065), rgba(255, 255, 255, 0.03));
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.045);
            padding: clamp(1.35rem, 5vw, 2.3rem);
            backdrop-filter: blur(20px);
        }

        .dashboard-login-logo {
            display: flex;
            justify-content: center;
            margin-bottom: 1.65rem;
        }

        .dashboard-login-logo img {
            width: auto;
            height: clamp(4rem, 13vw, 5.8rem);
            object-fit: contain;
            opacity: 0.96;
        }

        .dashboard-login-kicker {
            margin: 0 0 0.65rem;
            color: rgba(247, 241, 232, 0.42);
            font-size: 0.76rem;
            letter-spacing: 0.2em;
            line-height: 1.2;
            text-align: center;
            text-transform: uppercase;
        }

        .dashboard-login-title {
            margin: 0;
            color: rgba(247, 241, 232, 0.94);
            font-size: clamp(2rem, 7vw, 2.7rem);
            font-weight: 400;
            line-height: 1.02;
            text-align: center;
        }

        .dashboard-login-subtitle {
            max-width: 21rem;
            margin: 0.9rem auto 1.9rem;
            color: rgba(247, 241, 232, 0.62);
            font-size: 1rem;
            line-height: 1.45;
            text-align: center;
        }

        .dashboard-login-form {
            display: grid;
            gap: 0.95rem;
        }

        .dashboard-login input:not([type="checkbox"]) {
            width: 100%;
            min-height: 3.05rem;
            border: 1px solid rgba(247, 241, 232, 0.16);
            border-radius: 999px;
            outline: none;
            background: rgba(255, 255, 255, 0.045);
            color: rgba(247, 241, 232, 0.94);
            padding: 0.86rem 1rem;
            font: inherit;
            font-size: 1rem;
            transition: border-color 180ms ease, background 180ms ease;
        }

        .dashboard-login input::placeholder {
            color: rgba(247, 241, 232, 0.42);
        }

        .dashboard-login input:focus {
            border-color: rgba(247, 241, 232, 0.56);
            background: rgba(255, 255, 255, 0.07);
        }

        .dashboard-login-check {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            color: rgba(247, 241, 232, 0.58);
            font-size: 0.95rem;
        }

        .dashboard-login-check input {
            width: 1rem;
            height: 1rem;
            accent-color: #f7f1e8;
        }

        .dashboard-login-button {
            display: inline-flex;
            width: 100%;
            min-height: 3.05rem;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(247, 241, 232, 0.34);
            border-radius: 999px;
            background: rgba(247, 241, 232, 0.92);
            color: #050505;
            cursor: pointer;
            font: inherit;
            font-size: 1rem;
            font-weight: 500;
            transition: background 220ms ease, transform 220ms ease, opacity 220ms ease;
        }

        .dashboard-login-button:hover,
        .dashboard-login-button:focus-visible {
            background: #ffffff;
            opacity: 0.94;
            transform: translateY(-1px);
        }

        .dashboard-login-alert,
        .dashboard-login-session {
            border: 1px solid rgba(247, 241, 232, 0.14);
            border-radius: 0.9rem;
            background: rgba(255, 255, 255, 0.06);
            color: rgba(247, 241, 232, 0.82);
            padding: 0.8rem 0.95rem;
            font-size: 0.95rem;
            line-height: 1.35;
        }

        .dashboard-login-alert {
            color: rgba(255, 178, 164, 0.9);
        }

        .dashboard-login a {
            color: rgba(247, 241, 232, 0.92);
            border-bottom: 1px solid rgba(247, 241, 232, 0.28);
            text-decoration: none;
        }

        @keyframes yfai-login-smoke {
            0%, 100% {
                opacity: 0.34;
                transform: scale(1);
            }

            50% {
                opacity: 0.5;
                transform: scale(1.04) translate3d(0.7rem, -0.35rem, 0);
            }
        }
    </style>
{% endblock %}

{% block body %}
    <main class="dashboard-login" aria-labelledby="dashboard-login-title">
        <section class="dashboard-login-card">
            <a class="dashboard-login-logo" href="{{ path('recommendation_form') }}" aria-label="YFAI home">
                <img src="{{ asset('images/YFAI1.png') }}" alt="YF">
            </a>

            <h1 class="dashboard-login-title" id="dashboard-login-title">Private Atelier</h1>
            <p class="dashboard-login-subtitle">
                Curate your perfume catalogue and shape your AI scent experience.
            </p>

            <form method="post" class="dashboard-login-form">
                {% if error %}
                    <div class="dashboard-login-alert" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="dashboard-login-session">
                        You are logged in as {{ app.user.email }},
                        <a href="{{ path('app_dashboard_logout') }}">{{ 'Logout'|trans }}</a>.
                    </div>
                {% endif %}

                <input type="email" name="email" id="inputEmail" placeholder="Email" required autofocus>
                <input type="password" name="password" id="inputPassword" required placeholder="Password">

                <label for="remember_me" class="dashboard-login-check">
                    <input type="checkbox" name="_remember_me" id="remember_me">
                    {{ 'Remember me'|trans }}
                </label>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="dashboard-login-button" type="submit">
                    {{ 'Sign in'|trans }}
                </button>
            </form>
        </section>
    </main>
{% endblock %}
