{% extends 'dashboard/base.html.twig' %}

{% block title %}Brands · Dashboard{% endblock %}

{% block body %}
    <section class="dashboard-page">
        <header class="dashboard-page-header">
            <div>
                <p class="dashboard-page-kicker">Catalog houses</p>
                <h1 class="dashboard-title">Brands</h1>
                <p class="dashboard-subtitle">
                    Manage fragrance houses and partner identities used across YFAI recommendations.
                </p>
            </div>

            <div class="dashboard-actions">
                <a href="{{ path('dashboard_brand_new') }}" class="dashboard-button">Create brand</a>
            </div>
        </header>

        <div class="table-shell">
            <table>
                <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Country</th>
                <th>Description</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>actions</th>
            </tr>
                </thead>
                <tbody>
                {% for brand in brands %}
                    <tr>
                        <td>{{ brand.id }}</td>
                        <td>{{ brand.name }}</td>
                        <td>{{ brand.country ?: '—' }}</td>
                        <td>{{ brand.description ?: 'No description yet.' }}</td>
                        <td>{{ brand.createdAt ? brand.createdAt|date('Y-m-d H:i') : '—' }}</td>
                        <td>{{ brand.updatedAt ? brand.updatedAt|date('Y-m-d H:i') : '—' }}</td>
                        <td>
                            <div class="record-actions">
                                <a href="{{ path('dashboard_brand_show', {'id': brand.id}) }}">Show</a>
                                <a href="{{ path('dashboard_brand_edit', {'id': brand.id}) }}" class="dashboard-button secondary">Edit</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="dashboard-empty">
                            No brands yet. Create the first house in the catalog.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
