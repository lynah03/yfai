{% extends 'dashboard/base.html.twig' %}

{% block title %}Brand{% endblock %}

{% block body %}
    <section class="dashboard-page">
        <header class="dashboard-form-header">
            <div>
                <p class="dashboard-page-kicker">Brand house</p>
                <h1 class="dashboard-title">{{ brand.name }}</h1>
                <p class="dashboard-subtitle">{{ brand.description ?: 'No brand description has been added yet.' }}</p>
            </div>

            <div class="dashboard-actions">
                <a href="{{ path('dashboard_brand_index') }}" class="dashboard-button secondary">Back to brands</a>
                <a href="{{ path('dashboard_brand_edit', {'id': brand.id}) }}" class="dashboard-button">Edit brand</a>
                {{ include('dashboard/brand/_delete_form.html.twig') }}
            </div>
        </header>

        <div class="table-shell">
            <table>
                <tbody>
            <tr>
                <th>Id</th>
                <td>{{ brand.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ brand.name }}</td>
            </tr>
            <tr>
                <th>Country</th>
                <td>{{ brand.country }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ brand.description }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ brand.createdAt ? brand.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ brand.updatedAt ? brand.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
