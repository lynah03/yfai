{% extends 'dashboard/base.html.twig' %}

{% block title %}New Brand{% endblock %}

{% block body %}
    <section class="dashboard-page">
        <header class="dashboard-form-header">
            <div>
                <p class="dashboard-page-kicker">Brand house</p>
                <h1 class="dashboard-title">Create brand</h1>
                <p class="dashboard-subtitle">Add a house profile for catalog ownership and concierge presentation.</p>
            </div>

            <div class="dashboard-actions">
                <a href="{{ path('dashboard_brand_index') }}" class="dashboard-button secondary">Back to brands</a>
            </div>
        </header>

        <div class="yfai-form-card">
            <div class="card-body">
                {{ include('dashboard/brand/_form.html.twig') }}
            </div>
        </div>
    </section>
{% endblock %}
