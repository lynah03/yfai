{% extends 'dashboard/base.html.twig' %}

{% block title %}PerfumeNote{% endblock %}

{% block body %}
    <section class="dashboard-page">
        <header class="dashboard-form-header">
            <div>
                <p class="dashboard-page-kicker">Olfactive structure</p>
                <h1 class="dashboard-title">Perfume note</h1>
                <p class="dashboard-subtitle">Review this note layer and its matching weight.</p>
            </div>

            <div class="dashboard-actions">
                <a href="{{ path('dashboard_perfume_note_index') }}" class="dashboard-button secondary">Back to note layers</a>
                <a href="{{ path('dashboard_perfume_note_edit', {'id': perfume_note.id}) }}" class="dashboard-button">Edit layer</a>
                {{ include('dashboard/perfume_note/_delete_form.html.twig') }}
            </div>
        </header>

        <div class="table-shell">
            <table>
                <tbody>
            <tr>
                <th>Id</th>
                <td>{{ perfume_note.id }}</td>
            </tr>
            <tr>
                <th>Layer</th>
                <td>{{ perfume_note.layer }}</td>
            </tr>
            <tr>
                <th>Intensity</th>
                <td>{{ perfume_note.intensity }}</td>
            </tr>
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
