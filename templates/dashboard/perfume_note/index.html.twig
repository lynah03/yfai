{% extends 'dashboard/base.html.twig' %}

{% block title %}Perfume notes · Dashboard{% endblock %}

{% block body %}
    <section class="w-full max-w-6xl mx-auto">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-semibold text-gray-900">Perfume notes</h1>
                <p class="text-sm text-gray-500">
                    View and manage note layers & intensities used by the recommendation engine.
                </p>
            </div>
            <a href="{{ path('dashboard_perfume_note_new') }}"
               class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-xl border border-gray-900 bg-gray-900 text-ivory hover:bg-black hover:-translate-y-0.5 transition">
                + New perfume note
            </a>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-sm">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-4 py-3 font-medium text-gray-500 uppercase tracking-wide text-xs text-center">ID</th>
                    <th class="px-4 py-3 font-medium text-gray-500 uppercase tracking-wide text-xs text-center">Perfume</th>
                    <th class="px-4 py-3 font-medium text-gray-500 uppercase tracking-wide text-xs text-center">Note</th>
                    <th class="px-4 py-3 font-medium text-gray-500 uppercase tracking-wide text-xs text-center">Layer</th>
                    <th class="px-4 py-3 font-medium text-gray-500 uppercase tracking-wide text-xs text-center">Intensity</th>
                    <th class="px-4 py-3 font-medium text-gray-500 uppercase tracking-wide text-xs text-center w-48">Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for perfume_note in perfume_notes %}
                    <tr class="border-b border-gray-100 hover:bg-gray-50 transition">
                        <td class="px-4 py-3 text-gray-600 text-center">
                            {{ perfume_note.id }}
                        </td>
                        <td class="px-4 py-3 text-gray-800 text-center">
                            {% if perfume_note.perfume is defined and perfume_note.perfume %}
                                {{ perfume_note.perfume.name ?? ('#' ~ perfume_note.perfume.id) }}
                            {% else %}
                                <span class="text-gray-400">—</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-gray-800 text-center">
                            {% if perfume_note.note is defined and perfume_note.note %}
                                {{ perfume_note.note.name ?? ('#' ~ perfume_note.note.id) }}
                            {% else %}
                                <span class="text-gray-400">—</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-center">
                        <span class="inline-flex px-2 py-0.5 rounded-full bg-gray-900 text-ivory text-[10px] tracking-wide">
                            {{ perfume_note.layer|upper }}
                        </span>
                        </td>
                        <td class="px-4 py-3 text-center text-gray-800">
                            {{ perfume_note.intensity is not null ? perfume_note.intensity : '—' }}
                        </td>
                        <td class="px-4 py-3 text-center">
                            <div class="inline-flex items-center justify-center gap-3">
                                <a href="{{ path('dashboard_perfume_note_show', {'id': perfume_note.id}) }}"
                                   class="text-xs font-medium text-gray-700 hover:text-black underline underline-offset-4">
                                    Show
                                </a>
                                <a href="{{ path('dashboard_perfume_note_edit', {'id': perfume_note.id}) }}"
                                   class="px-3 py-1.5 text-xs font-medium rounded-xl border border-gray-900 text-gray-900 hover:bg-black hover:text-ivory transition">
                                    Edit
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="px-4 py-6 text-center text-gray-500 text-sm">
                            No perfume notes found yet.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
