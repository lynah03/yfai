{% extends 'dashboard/base.html.twig' %}

{% block title %}New PerfumeNote{% endblock %}

{% block body %}
    <section class="dashboard-page">
        <header class="dashboard-form-header">
            <div>
                <p class="dashboard-page-kicker">Olfactive structure</p>
                <h1 class="dashboard-title">Create perfume note</h1>
                <p class="dashboard-subtitle">Connect a note to a perfume with its layer and intensity.</p>
            </div>

            <div class="dashboard-actions">
                <a href="{{ path('dashboard_perfume_note_index') }}" class="dashboard-button secondary">Back to note layers</a>
            </div>
        </header>

        <div class="yfai-form-card">
            <div class="card-body">
                {{ include('dashboard/perfume_note/_form.html.twig') }}
            </div>
        </div>
    </section>
{% endblock %}
