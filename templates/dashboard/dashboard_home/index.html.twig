{% extends 'dashboard/base.html.twig' %}

{% block body %}
    <section class="dashboard-page">
        <header class="dashboard-page-header">
            <div>
                <p class="dashboard-page-kicker">Private atelier</p>
                <h1 class="dashboard-title">An intelligent approach to scent.</h1>
                <p class="dashboard-subtitle">
                    Curate the fragrance catalog, brand houses and olfactive data that shape every YFAI recommendation.
                </p>
            </div>
        </header>

        <div class="dashboard-overview-grid">
            <a class="dashboard-overview-card" href="{{ path('dashboard_brand_index') }}">
                <div>
                    <span>Brand houses</span>
                    <h2>Manage brands</h2>
                    <p>Maintain partner identities, origin stories and white-label catalog ownership.</p>
                </div>
                <span>Open brands</span>
            </a>

            <a class="dashboard-overview-card" href="{{ path('dashboard_perfume_index') }}">
                <div>
                    <span>Fragrance catalog</span>
                    <h2>Curate perfumes</h2>
                    <p>Refine product imagery, concentration, pricing, seasons and recommendation-ready copy.</p>
                </div>
                <span>Open perfumes</span>
            </a>

            <a class="dashboard-overview-card" href="{{ path('dashboard_perfume_note_index') }}">
                <div>
                    <span>Olfactive structure</span>
                    <h2>Map perfume notes</h2>
                    <p>Shape the note layers and intensities that make the AI scent concierge feel precise.</p>
                </div>
                <span>Open note layers</span>
            </a>
        </div>
    </section>
{% endblock %}
